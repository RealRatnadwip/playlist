# Site & Environment
ENVIRONMENT=production
SITE_URL=https://playlist.ratnadwip.com

# Spotify Web API Credentials (obtain from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=https://playlist.ratnadwip.com/api/admin/spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=generate_a_random_32_character_hex_key_here

# Cloudflare D1 Database (configured in wrangler.toml)
# D1 binding name: DB

# Cloudflare R2 Bucket (optional, for persistent image uploads)
# R2 binding name: MEDIA_BUCKET

